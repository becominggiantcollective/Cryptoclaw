# OpenClaw / Cryptoclaw configuration
#
# Quick start:
# 1) Copy this file to `.env`.
# 2) Fill only the values you use.
# 3) Keep secrets out of git — .env is already in .gitignore.
#
# Full reference: https://docs.openclaw.ai/config/env

# ---------------------------------------------------------------------------
# Gateway auth
# ---------------------------------------------------------------------------
# Required when the gateway is accessible beyond loopback.
# Generate a token with: openssl rand -hex 32
# Leave empty to let OpenClaw auto-generate one on first start.
OPENCLAW_GATEWAY_TOKEN=

# ---------------------------------------------------------------------------
# Model provider API keys (set at least one)
# ---------------------------------------------------------------------------
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...

# ---------------------------------------------------------------------------
# Channels (enable only the channels you use)
# ---------------------------------------------------------------------------
# TELEGRAM_BOT_TOKEN=123456:ABCDEF...
# DISCORD_BOT_TOKEN=...
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_APP_TOKEN=xapp-...
