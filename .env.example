# Runtime
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Wallet / chain
RPC_URL=https://sepolia.base.org
CHAIN_ID=84532
AGENT_PRIVATE_KEY=0xYOUR_PRIVATE_KEY
AGENT_PAYOUT_ADDRESS=0x0000000000000000000000000000000000000000

# ERC-8004 registries
ERC8004_IDENTITY_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
ERC8004_REPUTATION_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
ERC8004_VALIDATION_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000

# Function signatures are configurable to support concrete ERC-8004 implementations
ERC8004_IDENTITY_REGISTER_FN=registerIdentity(address,string)
ERC8004_REPUTATION_UPDATE_FN=updateReputation(address,int256,string)
ERC8004_VALIDATION_SUBMIT_FN=submitValidation(address,string,bool)
AGENT_METADATA_URI=ipfs://cryptoclaw/agent-metadata.json
AGENT_INITIAL_REPUTATION_DELTA=1

# x402
X402_FACILITATOR_URL=https://facilitator.x402.org
X402_NETWORK=eip155:84532
X402_PRICE_USD=$0.25

# LLM
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1
LLM_API_KEY=sk-REPLACE_ME

# Autonomy
AUTONOMY_LOOP_MS=120000
OPENCLAW_EXECUTION_MODE=gateway
OPENCLAW_AGENT_ARGS=--thinking high
OPENCLAW_AGENT_TIMEOUT_MS=90000
